<%- include('partials/head') %>
<%- include('partials/nav') %>

<header class="bg-kacang text-kertas">
  <div class="max-w-5xl mx-auto px-5 py-14">
    <h1 class="font-serif text-4xl sm:text-5xl font-bold leading-tight"><%= app.name %></h1>
    <p class="mt-3 text-lg text-kertas/80 max-w-xl"><%= app.tagline %></p>
    <a href="/pesan" class="mt-7 inline-block rounded bg-cabe px-6 py-3 font-bold text-white hover:bg-red-700">Pesan sekarang</a>
  </div>
</header>

<main class="max-w-5xl mx-auto px-5">

  <!-- Layanan -->
  <section class="mt-12">
    <h2 class="font-serif text-2xl font-bold">Layanan</h2>
    <p class="mt-1 text-sm text-kacang/70">Data dari <code>/api/layanan</code></p>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% layanan.forEach(function (l) { %>
        <li class="rounded-lg bg-white border border-kacang/15 p-5 flex flex-col <%= l.tersedia ? '' : 'opacity-60' %>">
          <h3 class="font-bold text-lg"><%= l.nama %></h3>
          <p class="mt-2 text-sm text-kacang/80 flex-1"><%= l.deskripsi %></p>
          <% if (l.tersedia && l.tautan) { %>
            <a href="<%= l.tautan %>" class="mt-4 text-sm font-bold text-cabe hover:underline">Buka layanan</a>
          <% } else { %>
            <span class="mt-4 text-sm font-semibold text-kacang/70">Belum tersedia di versi ini</span>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </section>

  <!-- Menu -->
  <section class="mt-14">
    <div class="flex items-baseline justify-between flex-wrap gap-2">
      <h2 class="font-serif text-2xl font-bold">Menu hari ini</h2>
      <span class="text-sm text-kacang/70"><%= produk.length %> item, data dari <code>/api/produk</code></span>
    </div>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% produk.forEach(function (p) { %>
        <li class="rounded-lg bg-white border border-kacang/15 p-5 flex flex-col <%= p.tersedia ? '' : 'opacity-60' %>">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-bold text-lg leading-snug"><%= p.nama %></h3>
            <span class="shrink-0 rounded px-2 py-0.5 text-xs font-semibold bg-daun/10 text-daun"><%= p.kategori %></span>
          </div>
          <p class="mt-2 text-sm text-kacang/80 flex-1"><%= p.deskripsi %></p>
          <p class="mt-3 text-xl font-bold text-cabe"><%= formatRupiah(p.harga) %></p>
          <p class="mt-2 text-xs text-kacang/70">Pilihan: <%= p.kustomisasi.join(', ') %></p>
          <% if (!p.tersedia) { %>
            <p class="mt-3 text-xs font-semibold text-kacang/70">Belum tersedia</p>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </section>

  <!-- Status server -->
  <section class="mt-14">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h2 class="font-serif text-2xl font-bold">Status server</h2>
      <p class="inline-flex items-center gap-2 text-sm font-semibold">
        <span id="status-dot" class="h-2.5 w-2.5 rounded-full bg-yellow-500"></span>
        <span id="status-text">Mengecek server...</span>
      </p>
    </div>
    <p class="mt-1 text-sm text-kacang/70">Data dari <code>/api/status</code>, diperbarui otomatis tiap 10 detik.</p>
    <dl class="mt-5 grid gap-3 grid-cols-2 lg:grid-cols-4">
      <% [
        ['aplikasi', 'Aplikasi'], ['versi', 'Versi'], ['uptime', 'Waktu aktif'], ['waktu', 'Waktu server'],
        ['node', 'Node.js'], ['memori', 'Memori'], ['produk', 'Jumlah produk'], ['pesanan', 'Pesanan masuk']
      ].forEach(function (f) { %>
        <div class="rounded-lg bg-white border border-kacang/15 p-4">
          <dt class="text-xs text-kacang/70"><%= f[1] %></dt>
          <dd id="st-<%= f[0] %>" class="mt-1 font-bold break-words">-</dd>
        </div>
      <% }) %>
    </dl>
  </section>
</main>

<%- include('partials/footer') %>

<script>
  function setText(id, v) { document.getElementById('st-' + id).textContent = v; }
  function formatUptime(detik) {
    var j = Math.floor(detik / 3600), m = Math.floor((detik % 3600) / 60), s = detik % 60;
    return (j ? j + ' j ' : '') + (m ? m + ' m ' : '') + s + ' d';
  }
  function cekStatus() {
    fetch('/api/status')
      .then(function (r) { return r.json(); })
      .then(function (d) {
        document.getElementById('status-dot').className = 'h-2.5 w-2.5 rounded-full bg-green-600';
        document.getElementById('status-text').textContent = 'Server ' + d.status;
        setText('aplikasi', d.aplikasi);
        setText('versi', d.versi);
        setText('uptime', formatUptime(d.uptime_detik));
        setText('waktu', new Date(d.waktu_server).toLocaleTimeString('id-ID'));
        setText('node', d.node_version);
        setText('memori', d.memori_mb + ' MB');
        setText('produk', d.total_produk);
        setText('pesanan', d.total_pesanan);
      })
      .catch(function () {
        document.getElementById('status-dot').className = 'h-2.5 w-2.5 rounded-full bg-red-600';
        document.getElementById('status-text').textContent = 'Server tidak merespons';
      });
  }
  cekStatus();
  setInterval(cekStatus, 10000);
</script>
