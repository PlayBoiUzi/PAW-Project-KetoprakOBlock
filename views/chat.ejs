<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="max-w-3xl mx-auto px-4 sm:px-5 mt-8 mb-10">
  <h1 class="font-serif text-3xl font-bold">Tanya asisten</h1>
  <p class="mt-1 text-sm text-kacang/70">Tanya soal menu, harga, dan cara pesan. Jawabannya berdasarkan data produk di database.</p>

  <section class="mt-5 flex h-[65vh] flex-col rounded-lg border border-kacang/15 bg-white">
    <div id="chat-log" class="flex-1 space-y-3 overflow-y-auto p-4" aria-live="polite">
      <div class="flex justify-start">
        <div class="max-w-[85%] rounded-lg bg-kertas px-3 py-2 text-sm">Halo! Mau tanya menu atau harga apa hari ini?</div>
      </div>
    </div>

    <div id="chat-error" class="mx-4 mb-2 hidden rounded bg-red-100 px-3 py-2 text-sm text-red-900" role="alert"></div>

    <form id="chat-form" class="flex gap-2 border-t border-kacang/15 p-3" novalidate>
      <input id="chat-input" type="text" maxlength="500" autocomplete="off"
        placeholder="Tulis pertanyaan..."
        class="min-w-0 flex-1 rounded border border-kacang/30 px-3 py-2 text-sm">
      <button id="chat-kirim" type="submit"
        class="rounded bg-cabe px-4 py-2 text-sm font-bold text-white hover:bg-red-700 disabled:opacity-50">Kirim</button>
    </form>
  </section>

  <div class="mt-3 flex flex-wrap gap-2 text-xs">
    <button type="button" data-saran="Apa saja produk yang tersedia?" class="rounded-full border border-kacang/30 px-3 py-1 hover:bg-kacang/5">Apa saja produk yang tersedia?</button>
    <button type="button" data-saran="Berapa harga ketoprak spesial?" class="rounded-full border border-kacang/30 px-3 py-1 hover:bg-kacang/5">Harga ketoprak spesial?</button>
  </div>
</main>

<%- include('partials/footer') %>

<script>
  var log = document.getElementById('chat-log');
  var form = document.getElementById('chat-form');
  var input = document.getElementById('chat-input');
  var tombol = document.getElementById('chat-kirim');
  var errBox = document.getElementById('chat-error');

  function gelembung(teks, dari) {
    var baris = document.createElement('div');
    baris.className = 'flex ' + (dari === 'user' ? 'justify-end' : 'justify-start');
    var isi = document.createElement('div');
    isi.className = 'max-w-[85%] whitespace-pre-wrap rounded-lg px-3 py-2 text-sm ' +
      (dari === 'user' ? 'bg-kacang text-kertas' : 'bg-kertas');
    isi.textContent = teks; // textContent: aman dari XSS
    baris.appendChild(isi);
    log.appendChild(baris);
    log.scrollTop = log.scrollHeight;
    return baris;
  }

  function kirim(teks) {
    errBox.classList.add('hidden');
    gelembung(teks, 'user');
    var loading = gelembung('Asisten sedang mengetik...', 'bot');
    loading.firstChild.classList.add('italic', 'opacity-70');
    tombol.disabled = true;
    input.disabled = true;

    fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: teks })
    })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        loading.remove();
        if (!res.ok || !res.d.success) {
          errBox.textContent = res.d.error || 'Terjadi kesalahan.';
          errBox.classList.remove('hidden');
          return;
        }
        gelembung(res.d.data.reply, 'bot');
      })
      .catch(function () {
        loading.remove();
        errBox.textContent = 'Server tidak merespons. Coba lagi.';
        errBox.classList.remove('hidden');
      })
      .then(function () {
        tombol.disabled = false;
        input.disabled = false;
        input.focus();
      });
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var teks = input.value.trim();
    if (!teks) return;
    input.value = '';
    kirim(teks);
  });

  document.querySelectorAll('[data-saran]').forEach(function (b) {
    b.addEventListener('click', function () { kirim(b.dataset.saran); });
  });
</script>